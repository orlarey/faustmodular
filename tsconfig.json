{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "allowJs": false,
        "noEmit": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "strict": true,
        // Relaxed for the legacy code base; to be tightened as it is rewritten.
        "noImplicitAny": false,
        "strictPropertyInitialization": false
    },
    "include": ["src"]
}
