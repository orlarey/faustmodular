  {
   "id": "1",
   "kind": "faust",
   "name": "OscillatorBank8",
   "code": "process = vgroup(\"OscillatorBank8\",environment{declare name \"Oscillator Bank 8\";\ndeclare author \"GRAME\";\nimport(\"stdfaust.lib\");\n\n/* =============== DESCRIPTION ================\n\n- 8 sine oscillators on 8 outputs: the harmonics 1 to 8 of a fundamental\n- Output k plays harmonic k with an amplitude 1/k\n- To spread them in space: connect the outputs to the ports of a spatializer or of the output\n\n*/\n\nprocess = vgroup(\"Oscillator Bank 8\", par(i, 8, os.osc(f0 * (i + 1)) * level / (i + 1)));\n\nf0 = hslider(\"Fundamental[unit:Hz]\", 110, 40, 440, 1) : si.smoo;\nlevel = hslider(\"Level\", 0.3, 0, 1, 0.01) : si.smoo;\n}.process);",
   "x": 100,
   "y": 140,
   "inputs": 0,
   "outputs": 8,
   "params": {
    "/OscillatorBank8/Oscillator_Bank_8/Fundamental": 110,
    "/OscillatorBank8/Oscillator_Bank_8/Level": 0.3
   },
   "acc": [
    {
     "address": "/OscillatorBank8/Oscillator_Bank_8/Fundamental",
     "axis": 0,
     "curve": 0,
     "amin": -10,
     "amid": 0,
     "amax": 10,
     "enabled": false
    },
    {
     "address": "/OscillatorBank8/Oscillator_Bank_8/Level",
     "axis": 0,
     "curve": 0,
     "amin": -10,
     "amid": 0,
     "amax": 10,
     "enabled": false
    }
   ]
  },
  {
   "id": "2",
   "kind": "faust",
   "name": "Mixer4to2",
   "code": "process = vgroup(\"Mixer4to2\",environment{declare name \"Mixer 4 to 2\";\ndeclare author \"GRAME\";\nimport(\"stdfaust.lib\");\n\n/* =============== DESCRIPTION ================\n\n- 4 inputs mixed to stereo (2 outputs), with a gain and a pan for each input\n\n*/\n\nprocess = vgroup(\"Mixer 4 to 2\", hgroup(\"Channels\", par(i, 4, channel(i))) :> _, _);\n\nchannel(i) = vgroup(\"%j\", *(gain) <: *(cos(a)), *(sin(a)))\nwith {\n\tj = i + 1;\n\tgain = vslider(\"Gain\", 0.7, 0, 1, 0.01) : si.smoo;\n\ta = hslider(\"Pan\", (i + 0.5) / 4, 0, 1, 0.01) : si.smoo : *(ma.PI / 2);\n};\n}.process);",
   "x": 480,
   "y": 60,
   "inputs": 4,
   "outputs": 2,
   "params": {
    "/Mixer4to2/Mixer_4_to_2/Channels/1/Gain": 0.7,
    "/Mixer4to2/Mixer_4_to_2/Channels/1/Pan": 0.125,
    "/Mixer4to2/Mixer_4_to_2/Channels/2/Gain": 0.7,
    "/Mixer4to2/Mixer_4_to_2/Channels/2/Pan": 0.375,
    "/Mixer4to2/Mixer_4_to_2/Channels/3/Gain": 0.7,
    "/Mixer4to2/Mixer_4_to_2/Channels/3/Pan": 0.625,
    "/Mixer4to2/Mixer_4_to_2/Channels/4/Gain": 0.7,
    "/Mixer4to2/Mixer_4_to_2/Channels/4/Pan": 0.875
   },
