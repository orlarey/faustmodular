declare name "Resonator Oscillator";
declare author "Faust libraries";
declare source "dm.oscr_demo (demos.lib)";
import("stdfaust.lib");

/* =============== DESCRIPTION ================

- Simple application demoing filter based oscillators.
- Sine oscillator demo based on 2D vector rotation. Synonym for `oscrs_demo`.
- From the Faust libraries: dm.oscr_demo (demos.lib)

*/

process = dm.oscr_demo;
